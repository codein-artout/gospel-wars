# Gospel Wars environment. Every variable is optional for local development:
# with nothing set, the app runs on PGlite (embedded Postgres in .pglite/) and the MockProvider.

# --- Database ---
# Postgres connection string (Neon in production). Unset = PGlite.
DATABASE_URL=
# Where PGlite stores its data when DATABASE_URL is unset. Default: .pglite
PGLITE_DIR=

# --- Auth.js ---
# Required in production. Generate with: openssl rand -base64 32
# Unset locally = a random secret is generated once and kept in .pglite/auth-secret.
AUTH_SECRET=
# Public URL of the site (production). Locally Auth.js infers it.
AUTH_URL=
# Set to true behind a proxy that you trust (Vercel sets this automatically).
AUTH_TRUST_HOST=
# SMTP connection string for magic links, e.g. smtp://user:pass@smtp.example.com:587
# Unset = the sign-in link is printed to the server console.
EMAIL_SERVER=
EMAIL_FROM="Gospel Wars <no-reply@gospelwars.local>"
# Comma-separated admin emails.
ADMIN_EMAILS=admin@gospelwars.test
# Enables the email-only dev login in a production build (e2e). Always on in development and test.
# Never set this on a public deployment.
GW_ENABLE_DEV_LOGIN=

# --- Ticks ---
# Bearer token for POST /api/cron/tick. Vercel Cron sends it automatically when set as CRON_SECRET.
CRON_SECRET=

# --- LLM ---
# Unset = MockProvider (deterministic, free). Set = AnthropicProvider for every role.
ANTHROPIC_API_KEY=
